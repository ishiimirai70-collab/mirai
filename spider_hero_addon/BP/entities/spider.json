{
  "format_version": "1.21.80",
  "minecraft:entity": {
    "description": {
      "identifier": "webhero:spider",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {}
    },
    "component_groups": {
      "webhero:awakened": {
        "minecraft:interact": {
          "interactions": [
            {
              "on_interact": {
                "event": "webhero:transform_to_hero",
                "target": "self"
              },
              "cooldown": 1.0,
              "swing": false,
              "play_sounds": ["mob.spider.say"]
            }
          ]
        }
      },
      "webhero:begin_transform_to_hero": {
        "minecraft:transformation": {
          "into": "webhero:hero_form",
          "delay": {
            "value": 0.4
          },
          "begin_transform_sound": "mob.spider.say",
          "transformation_sound": "mob.shulker.close",
          "keep_owner": true,
          "add": {
            "component_groups": ["webhero:hero_awakened"]
          }
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["webhero_spider", "monster", "mob", "arthropod"]
      },
      "minecraft:collision_box": {
        "width": 1.4,
        "height": 0.9
      },
      "minecraft:health": {
        "value": 16,
        "max": 16
      },
      "minecraft:movement": {
        "value": 0.3
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:navigation.walk": {
        "avoid_water": true,
        "can_path_over_water": false,
        "can_walk": true
      },
      "minecraft:nameable": {},
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:attack": {
        "damage": 3
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 1.0
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "speed_multiplier": 1.25,
        "track_target": true
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": true,
        "within_radius": 16,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "villager"
            },
            "max_dist": 16
          }
        ]
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/webhero_spider.json"
      }
    },
    "events": {
      "webhero:on_bite": {
        "add": {
          "component_groups": ["webhero:awakened"]
        }
      },
      "webhero:transform_to_hero": {
        "add": {
          "component_groups": ["webhero:begin_transform_to_hero"]
        }
      }
    }
  }
}
